GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ALLOWED_EMAIL=
TEST_RECIPIENT_EMAIL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=
# Aiven PostgreSQL URL. Keep this server-only; never use NEXT_PUBLIC_ prefix.
DATABASE_URL=
# Optional dedicated server-side URI when a legacy Vercel storage integration
# still injects DATABASE_URL. Set only in the Aiven Preview environment.
AIVEN_DATABASE_URL=
# PEM CA certificate downloaded from the Aiven service overview. Vercel accepts
# multiline secrets; use \n only where the hosting UI requires it.
AIVEN_CA_CERT=
# Legacy spreadsheet configuration is preserved for rollback verification only.
GOOGLE_SHEETS_ID=

OFFICIAL_CAREERS_EMAIL=
GOOGLE_SHEETS_TAB=

ENABLE_DEMO_DATA=
GEMINI_API_KEY=
GEMINI_MODEL=

# Authenticate scheduled backend intake (configure the same value in the scheduler).
CRON_SECRET=
# Safe default is dry-run. Set to false only after completing retention tests.
DRY_RUN_RETENTION_CLEANUP=true
# Require a second explicit switch after running the documented retention QA.
RETENTION_CLEANUP_VERIFIED=false
# Optional Aiven service disk allocation in bytes for storage warning levels.
DB_STORAGE_LIMIT_BYTES=
# Aiven PgBouncer endpoint if enabled for the selected Startup+ service plan.
# Use the Aiven-provided pooled URI; keep the same AIVEN_CA_CERT verification.
DATABASE_POOL_URL=

# postgres is the production authority. "sheets" is only a preserved,
# temporary rollback source and must not be used after Aiven verification.
PERSISTENCE_PROVIDER=postgres
LOCAL_DATABASE_FILE=
# Configure these only after deploying scripts/sheets-gateway and verifying its target.
SHEETS_GATEWAY_URL=
SHEETS_GATEWAY_SECRET=
# Private API Executable alternative when Workspace prohibits public web apps:
SHEETS_GATEWAY_DEPLOYMENT_ID=
SHEETS_GATEWAY_REFRESH_TOKEN=
SHEETS_GATEWAY_CLIENT_ID=
SHEETS_GATEWAY_CLIENT_SECRET=
