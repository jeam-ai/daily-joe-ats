{
  "name": "daily-joe-careers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "node tests/api-smoke.mjs",
    "format": "prettier --write app components lib types tests next.config.ts",
    "format:check": "prettier --check app components lib types tests next.config.ts",
    "test:server": "node --conditions=react-server --import tsx --test tests/server/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@neon/config": "^1.7.1",
    "@neon/env": "^1.4.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "11.1.0",
    "lucide-react": "1.47.0",
    "mammoth": "^1.12.3",
    "next": "16.3.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
